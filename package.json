{
  "name": "bibleol-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\" \"tests/corpus/*.test.ts\" \"tests/quiz/*.test.ts\" \"tests/reader/*.test.ts\" \"tests/grades/*.test.ts\" \"tests/statistics/*.test.ts\" \"tests/i18n/*.test.ts\"",
    "test:e2e": "bash scripts/browser-libs.sh && LD_LIBRARY_PATH=\"$(cat .e2e/ldpath)\" node --test --test-concurrency=1 \"tests/e2e/*.test.ts\"",
    "db:init": "node scripts/migrate-schema.ts",
    "i18n:import": "node scripts/import-lang.mjs",
    "corpus:download": "node scripts/download-corpus.ts",
    "lexicons:build": "node scripts/build-lexicons.ts",
    "pic2db": "node scripts/pic2db.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.0.11",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "nodemailer": "^9.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "sax": "^1.6.1",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sax": "^1.2.7",
    "agents-md": "^1.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver",
    "better-sqlite3"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver",
    "better-sqlite3"
  ]
}
